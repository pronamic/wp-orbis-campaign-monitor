{
	"name": "pronamic/wp-orbis-campaign-monitor",
	"description": "The Orbis Campaign Monitor plugin connects your Orbis environment with Campaign Monitor.",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"orbis",
		"campaign-monitor",
		"wordpress",
		"plugin",
		"bootstrap"
	],
	"homepage": "https://www.pronamic.eu/orbis/",
	"authors": [
		{
			"name": "Remco Tolsma",
			"email": "info@remcotolsma.nl",
			"homepage": "http://www.remcotolsma.nl",
			"role": "Developer"
		},
		{
			"name": "Karel-Jan Tolsma",
			"email": "info@kareljantolsma.nl",
			"homepage": "http://www.kareljantolsma.nl",
			"role": "Developer"
		}
	],
	"support": {
		"email": "support@pronamic.nl",
		"issues": "https://github.com/pronamic/wp-orbis/issues",
		"source": "https://github.com/pronamic/wp-orbis"
	},
	"type": "wordpress-plugin",
	"autoload": {
		"classmap": ["classes/"]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"automattic/jetpack-autoloader": true
		},
		"wp-slug": "orbis-campaign-monitor"
	},
	"require": {
		"campaignmonitor/createsend-php": "^7.0",
		"automattic/jetpack-autoloader": "^3.0"
	},
	"require-dev": {
		"pronamic/wp-coding-standards": "^2.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*",
		"deployer/deployer": "^7.5"
	},
	"scripts": {
		"build": [
			"rm -rf ./build/stage-1",
			"rm -rf ./build/orbis-campaign-monitor",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/orbis-campaign-monitor/",
			"vendor/bin/wp i18n make-pot ./build/orbis-campaign-monitor/ --slug=orbis-campaign-monitor",
			"vendor/bin/wp i18n make-mo ./build/orbis-campaign-monitor/languages/",
			"vendor/bin/wp dist-archive ./build/orbis-campaign-monitor/ --plugin-dirname=orbis-campaign-monitor --force"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=orbis-campaign-monitor",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/orbis-campaign-monitor/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/orbis-campaign-monitor.pot"
		],
		"phpcs": "vendor/bin/phpcs --standard=phpcs.ruleset.xml",
		"qa": [
			"@phpcs"
		]
	}
}
